{
  "name": "rfc-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server for calling SAP classic RFC (SAP ECC and other ABAP systems) from a chat assistant, built on the SDK-free open-rfc client.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/espenleknes-stack/RFC_MCP.git"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "rfc-mcp": "dist/index.js"
  },
  "exports": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "test": "npm run build && vitest run",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run"
  },
  "engines": {
    "node": "^22.14.0 || ^24.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "open-rfc": "0.2.6",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "5.5.4",
    "vitest": "^5.1.1"
  }
}
